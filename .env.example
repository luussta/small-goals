# Public-facing name. This is shown in the page header and agent state.
APP_NAME="My Small Goals"
# Optional owner label for docs or future small copy; never a secret.
OWNER_NAME=""

# Required: Neon Postgres connection string (server-side only).
DATABASE_URL=""
# Required: long random token for the authenticated agent API.
AGENT_API_TOKEN=""
# Required: a separate password for the browser UI. Do not reuse the agent token.
APP_ACCESS_PASSWORD=""

# Local remote-verification inputs. Do not deploy these to the app runtime.
DEPLOYMENT_URL=""

# MCP client settings (normally configured in the MCP client's environment).
SMALL_GOALS_URL=""
SMALL_GOALS_TOKEN=""

# Shown in the app header. No source edits are needed to personalize the deployment.
APP_NAME="My Small Goals"
OWNER_NAME=""

# Required server-side secrets. Generate the API token with npm run generate-token.
# Choose a separate password for the browser login; the setup wizard asks for it hidden.
AGENT_API_TOKEN=""
APP_ACCESS_PASSWORD=""

# Vercel only: created and connected by npm run setup.
# Never set this in NEXT_PUBLIC_* or commit its value.
BLOB_READ_WRITE_TOKEN=""

# Local verification inputs; do not commit real values.
DEPLOYMENT_URL=""

# MCP client process configuration (normally stored in that client's private config).
SMALL_GOALS_URL=""
SMALL_GOALS_TOKEN=""

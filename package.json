{
  "name": "small-goals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "setup": "node scripts/bootstrap.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "install:codex-global": "node scripts/install-codex-global.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "generate-token": "node scripts/generate-token.mjs",
    "storage:init": "tsx scripts/storage-init.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:remote": "node scripts/verify-remote.mjs",
    "deploy:vercel": "npx --yes vercel --prod",
    "build:cloudflare": "npm run build:vinext",
    "preview:cloudflare": "npm run build:vinext && npm run start:vinext",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "mcp": "tsx mcp/server.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@next/env": "^16.3.8",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vinext": "^1.0.1",
    "vite": "^8.3.0"
  },
  "license": "MIT",
  "description": "A tiny personal goal and checklist app with an authenticated agent API and MCP server",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.8.3"
  }
}

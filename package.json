{
  "name": "small-goals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "setup": "npm install && npm run db:migrate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate-token": "node scripts/generate-token.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:remote": "node scripts/verify-remote.mjs",
    "deploy:vercel": "npx --yes vercel --prod",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && wrangler deploy",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "^16.3.8",
    "@opennextjs/cloudflare": "^1.20.8",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  },
  "license": "MIT",
  "description": "A tiny personal goal and checklist app with an authenticated agent API and MCP server",
  "engines": {
    "node": ">=20"
  }
}
